ENVIRONMENT=dev
PORT=3200
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=30

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=microservice
DB_SSL_MODE=disable

# Optional for the event-driven level. Leave empty for Level 1.
PUBSUB_PROJECT_ID=

# Used only by PostgreSQL integration tests.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/microservice?sslmode=disable
